# =========================================================================
# NUGI CONTENT FACTORY — ENVIRONMENT CONFIGURATION TEMPLATE
# Copy this file to .env and insert your API credentials if desired.
# Note: End users can also enter credentials directly in the Desktop UI Settings.
# =========================================================================

# Application Environment
APP_ENV=development
APP_NAME=Nugi Content Factory
DEBUG=True
PORT=8000

# =========================================================================
# 1. LLM PROVIDER CONFIGURATION
# Options: openrouter, openai, anthropic, google, custom, mock
# =========================================================================
LLM_PROVIDER=openrouter
OPENROUTER_API_KEY=your_openrouter_api_key_here
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_MODEL=google/gemini-2.5-flash-lite

# Optional Alternative LLMs
# OPENAI_API_KEY=your_openai_key_here
# OPENAI_BASE_URL=https://api.openai.com/v1
# OPENAI_MODEL=gpt-4o-mini
# ANTHROPIC_API_KEY=your_anthropic_key_here
# GOOGLE_API_KEY=your_gemini_key_here

# =========================================================================
# 2. IMAGE GENERATION PROVIDER CONFIGURATION
# Options: flux, openrouter, openai, custom, mock
# =========================================================================
IMAGE_PROVIDER=flux
FLUX_API_KEY=your_bfl_flux_api_key_here
FLUX_BASE_URL=https://api.bfl.ai/v1
FLUX_MODEL=flux-2-klein-9b

# =========================================================================
# 3. COMPUTE PROVIDER (OPTIONAL — Heavy Workloads Only)
# Options: local, runpod, mock
# =========================================================================
COMPUTE_PROVIDER=local
# RUNPOD_API_KEY=your_runpod_key_here
# RUNPOD_ENDPOINT_ID=your_runpod_endpoint_id_here

# Local Storage Base Directory
STORAGE_PROVIDER=local
STORAGE_BASE_DIR=./storage/assets
