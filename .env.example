# ==============================================================================
# NUGI CONTENT FACTORY - ENVIRONMENT CONFIGURATION TEMPLATE
# ==============================================================================

# Application Environment (development | testing | production)
APP_ENV=development
APP_NAME="Nugi Content Factory"
DEBUG=true

# Server Configuration
HOST=127.0.0.1
PORT=8000
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Database Connection (SQLite by default for zero-setup, PostgreSQL ready)
DATABASE_URL=sqlite:///./nugi_content_factory.db
# PostgreSQL Example: postgresql+psycopg2://user:password@localhost:5432/nugi_content_factory

# File Storage Configuration
STORAGE_PROVIDER=local
STORAGE_BASE_DIR=./storage/assets

# AI Provider Configuration (Phase 1 default is 'mock')
LLM_PROVIDER=mock
IMAGE_PROVIDER=mock

# Future Provider API Keys (Leave blank during Phase 1 Foundation)
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
FLUX_API_KEY=

# Rendering Configuration
DEFAULT_IMAGE_WIDTH=1080
DEFAULT_IMAGE_HEIGHT=1080
DEFAULT_FONT_FAMILY=sans-serif
